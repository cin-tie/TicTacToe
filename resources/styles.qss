/* resources/styles.qss */
QMainWindow, QDialog {
    background-color: #333333;
    color: #f0f0f0;
    font-family: Arial;
    font-size: 12px;
}

QMenuBar {
    background-color: #444444;
    color: #f0f0f0;
    border: none;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background-color: #ff8c00;
}

QMenu {
    background-color: #444444;
    border: 1px solid #555555;
}

QMenu::item:selected {
    background-color: #ff8c00;
    color: #ffffff;
}

QPushButton {
    background-color: #ff8c00;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 10px;
    min-width: 60px;
}

QPushButton:hover {
    background-color: #ff9e33;
}

QPushButton:pressed {
    background-color: #e67e00;
}

QPushButton:disabled {
    background-color: #777777;
    color: #aaaaaa;
}

QSpinBox, QComboBox, QLineEdit {
    background-color: #444444;
    color: #f0f0f0;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 3px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #555555;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QLabel {
    color: #f0f0f0;
}

QMessageBox {
    background-color: #333333;
}

QMessageBox QLabel {
    color: #f0f0f0;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QStatusBar {
    background-color: #444444;
    color: #f0f0f0;
}

/* Стиль для клеток игрового поля */
GameBoard QPushButton {
    background-color: #444444;
    color: white;
    font-size: 24px;
    min-width: 50px;
    min-height: 50px;
    border: 1px solid #555555;
}

GameBoard QPushButton:hover {
    background-color: #555555;
}

GameBoard QPushButton:pressed {
    background-color: #666666;
}